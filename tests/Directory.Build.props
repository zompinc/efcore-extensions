<Project>
  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <NoWarn>$(NoWarn);CA1810</NoWarn>

    <!-- Slow logger is just fine -->
    <NoWarn>$(NoWarn);CA1848</NoWarn>

    <!-- Don't care about the naming in testing projects -->
    <NoWarn>$(NoWarn);CA1711;CA1707</NoWarn>

    <!-- Don't care about making classes internal -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>

    <!-- No UI thread -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>

    <!-- Don't need comments -->
    <NoWarn>$(NoWarn);SA1600</NoWarn>

    <!-- Look into ToString soon -->
    <NoWarn>$(NoWarn);CA1305</NoWarn>

    <NoWarn>$(NoWarn);SA1601</NoWarn>
    <NoWarn>$(NoWarn);SA1502</NoWarn>

    <!-- An awaited TUnit assertion returns the value it checked -->
    <NoWarn>$(NoWarn);IDE0058</NoWarn>

    <!-- Tests exercise the experimental AsSubQuery -->
    <NoWarn>$(NoWarn);ZOMPEF001</NoWarn>

    <!--
      Verify requires a maintenance fee, from which open source projects that earn no revenue are exempt
      (https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md). The exemption lasts at most 12 months:
      the build fails with SC021 after the month below until it is renewed.
    -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <ItemGroup Condition="$(AssemblyName.EndsWith('.Tests'))">
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!-- Snapshots of the SQL the window function rewrites generate, one folder per provider -->
  <ItemGroup Condition="$(AssemblyName.StartsWith('Zomp.EFCore.WindowFunctions.')) And $(AssemblyName.EndsWith('.Tests'))">
    <PackageReference Include="Verify.TUnit" />
    <Using Include="VerifyTUnit.Verifier" Static="true" />
  </ItemGroup>

  <ItemGroup Condition="$(AssemblyName.EndsWith('.Tests'))">
    <Using Include="Microsoft.EntityFrameworkCore" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Globalization" />
    <Using Include="System.Linq.Expressions" />
    <Using Include="TUnit.Assertions.Enums" />
    <Using Include="Zomp.EFCore.Testing" />
    <Using Include="Zomp.EFCore.Testing.TestFixture" Static="true" />
  </ItemGroup>
</Project>
