<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for the code coverage of dotnet test (Microsoft.Testing.Extensions.CodeCoverage). -->
<Configuration>
  <CodeCoverage>
    <!-- Source generated files, such as the window function overloads, are not code anyone writes by hand. -->
    <Sources>
      <Exclude>
        <Source>.*\.g\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
