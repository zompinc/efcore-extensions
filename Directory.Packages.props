<Project>
  <PropertyGroup Condition="$(DefineConstants.Contains(EF_CORE_8))">
    <NetRuntime>8.0.11</NetRuntime>
    <NpgsqlVersion>8.0.10</NpgsqlVersion>
  </PropertyGroup>
  <PropertyGroup Condition="!$(DefineConstants.Contains(EF_CORE_8)) and $(DefineConstants.Contains(EF_CORE_9))">
    <NetRuntime>9.0.0</NetRuntime>
    <NpgsqlVersion>9.0.2</NpgsqlVersion>
  </PropertyGroup>
  <PropertyGroup Condition="!$(DefineConstants.Contains(EF_CORE_8)) and !$(DefineConstants.Contains(EF_CORE_9))">
    <NetRuntime>10.0.0</NetRuntime>
    <NpgsqlVersion>10.0.0</NpgsqlVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Fody" Version="6.9.3" />
    <PackageVersion Include="InfoOf.Fody" Version="2.2.0" />
    <!-- Roslyn shipped with the .NET 8 SDK, the oldest SDK the source generator must load in -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.100" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(NetRuntime)" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="TUnit" Version="1.68.17" />
    <PackageVersion Include="TUnit.Core" Version="1.68.17" />
    <PackageVersion Include="Verify.TUnit" Version="33.1.1" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <!-- Microsoft.Data.SqlClient, which EF Core SQL Server brings in, asks for a version with GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>
</Project>